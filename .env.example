PORT=3000
NODE_ENV=development
MONGODB_URI=

# Generate a strong JWT secret for production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Set to your frontend origin in production, for example:
# https://sentinel-scan.onrender.com
CORS_ORIGIN=*

# Optional Google OAuth client ID for Google sign-in. Use the same value in Google Cloud and Render.
# Authorized JavaScript origins must include http://localhost:3000 and your Render service URL.
GOOGLE_CLIENT_ID=

# Reserved for optional AI integrations.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_API_URL=

